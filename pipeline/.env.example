# Copy this file to ".env" (same folder) and fill it in. ".env" is never committed.

# Your real, monitored email. It goes into the User-Agent of every web request so a
# website (the SEC requires this) can contact us if our tool misbehaves.
CONTACT_EMAIL=yourname@umich.edu

# Optional: keep the database and downloaded files somewhere other than pipeline/data
# BLOOMFIELD_DATA_DIR=/some/other/folder

# ---- Part B (the AI reader and scout) ----
# Which AI company to use: anthropic, gemini or openai_compatible (default is in config/reader.yaml)
# LLM_PROVIDER=gemini
# Your API key. NEVER commit it or paste it into chat.
# (ANTHROPIC_API_KEY, GEMINI_API_KEY / GOOGLE_API_KEY or OPENAI_API_KEY also work, matching the provider.)
# LLM_API_KEY=
# Only for openai_compatible: the service address, e.g. https://api.openai.com/v1
# LLM_BASE_URL=
# Optional: override the model names in config/reader.yaml without editing it
# LLM_MODEL_CHEAP=
# LLM_MODEL_STRONG=
