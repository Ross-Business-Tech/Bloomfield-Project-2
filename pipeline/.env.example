# Copy this file to ".env" (same folder) and fill it in. ".env" is never committed.

# Your real, monitored email. It goes into the User-Agent of every web request so a
# website (the SEC requires this) can contact us if our tool misbehaves.
CONTACT_EMAIL=yourname@umich.edu

