# U-M Toolkit defaults; see UMICH-WORKFLOW.md.
# Copy this file to ".env" (same folder) and fill it in. ".env" is never committed.

# Your real, monitored email. It goes into the User-Agent of every web request so a
# website (the SEC requires this) can contact us if our tool misbehaves.
CONTACT_EMAIL=yourname@umich.edu

# Optional: keep the database and downloaded files somewhere other than pipeline/data
# BLOOMFIELD_DATA_DIR=/some/other/folder

# ---- Part B (the AI reader and scout) ----
# Default: U-M GPT Toolkit, not an OpenAI platform/Codex credential.
# This variable name belongs to the OpenAI-compatible adapter; the key is U-M's.
OPENAI_API_KEY=replace-with-your-um-toolkit-key
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.toolkit.umgpt.umich.edu/v1
LLM_MODEL_CHEAP=gpt-4o-mini
LLM_MODEL_STRONG=gpt-4o
# See UMICH-WORKFLOW.md; python -m llm.check verifies both models.
# For another provider, override provider, endpoint and models together.
# OpenAI platform Responses: LLM_PROVIDER=openai_responses,
# LLM_BASE_URL=https://api.openai.com/v1 and accessible OpenAI models.
# Other adapters use ANTHROPIC_API_KEY or GEMINI_API_KEY / GOOGLE_API_KEY.
# LLM_API_KEY is a fallback; OPENAI_API_KEY takes precedence for the U-M adapter.
