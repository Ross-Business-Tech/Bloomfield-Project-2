# Copy this file to Neel/.env and fill in values. Never commit .env.

# Required for every collector that downloads. SEC requires a name + contact email,
# e.g. "Bloomfield AI Sprint Team yourname@umich.edu"
USER_AGENT=

# Database. Blank = SQLite file at Neel/data/bloomfield.sqlite.
# Postgres example: postgresql+psycopg://user:password@host:5432/bloomfield
DB_URL=

# Where downloaded files and the SQLite file go. Blank = Neel/data/
DATA_DIR=
# Where raw file bytes go. Blank = $DATA_DIR/raw_files/
RAW_FILES_DIR=

# Path to Bloomfield's latest Trepp export (CSV or XLSX). Keep it OUTSIDE the repo
# or in Neel/trepp_exports/ (git-ignored). Used when trepp.py is run without a path.
TREPP_EXPORT_PATH=
